/* ============================================================
   MAGAZINE VIEWER — Stage 1 & 3
   ============================================================ */

.magazine-viewer {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    height: 100vh;
    background-color: #1a1a1a;
    box-sizing: border-box;
    font-family: 'Inter', sans-serif;
    overflow: hidden;
}

/* ── Top Bar ─────────────────────────────────────────────── */
.viewer-top-bar {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 24px;
    background-color: rgba(26, 26, 26, 0.95);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    z-index: 10;
}

.viewer-identity h2 {
    color: #ffffff;
    font-size: 1.1rem;
    font-weight: 600;
    margin: 0 0 2px 0;
}

.viewer-subtitle {
    color: #9ca3af;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
}

.viewer-top-actions {
    display: flex;
    gap: 12px;
}

/* ── viewport ─────────────────────────────────────────────── */
.magazine-viewport {
    width: 100%;
    flex: 1;
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: hidden;
    min-height: 0;
    padding: 16px;
}

/* ── flipbook container ───────────────────────────────────── */
.flipbook-container {
    position: relative;
    background: transparent;
    /* Apply drop shadow to the actual page boundaries */
    filter: drop-shadow(0 10px 20px rgba(0, 0, 0, 0.4));
}

/* Portrait mode (mobile) - single page view */
@media (max-width: 599px) {
    .flipbook-container {
        width: 100%;
        height: 100%;
        max-width: 100%;
    }
}

/* Landscape mode (desktop) - two page spread */
@media (min-width: 600px) {
    .flipbook-container {
        /* Force container to tightly wrap the exact 2-page aspect ratio */
        height: 100%;
        width: auto;
        max-width: 2482px;
        max-height: 1754px;
        aspect-ratio: 2482 / 1754;
    }
}

.magazine-page {
    background-color: white;
    overflow: hidden;
}

.page-image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
    background-color: white;
}

/* ── controls bar ─────────────────────────────────────────── */
.magazine-controls {
    flex-shrink: 0;
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 20px;
    padding: 16px 24px;
    background-color: rgba(26, 26, 26, 0.95);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    color: #e0e0e0;
}

.control-btn {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #e0e0e0;
    padding: 8px 18px;
    border-radius: 20px;
    cursor: pointer;
    transition: background 0.2s, border-color 0.2s, opacity 0.2s;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.3px;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
}

.control-btn:hover:not(:disabled) {
    background: rgba(255, 255, 255, 0.15);
    border-color: rgba(255, 255, 255, 0.5);
    color: #fff;
}

.control-btn:disabled {
    opacity: 0.4;
    cursor: not-allowed;
}

.control-btn:focus-visible, .page-input:focus-visible {
    outline: 2px solid #4a9eff;
    outline-offset: 2px;
}

.btn-exit {
    background: transparent;
    border-color: rgba(255, 255, 255, 0.3);
}

/* ── Page Indicator & Input ──────────────────────────────── */
.page-indicator {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 500;
}

.page-input {
    width: 50px;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #fff;
    padding: 6px 4px;
    text-align: center;
    border-radius: 4px;
    font-family: inherit;
    font-size: 14px;
    font-weight: 600;
    transition: border-color 0.2s;
}

.page-input:focus {
    border-color: #4a9eff;
    background: rgba(255, 255, 255, 0.15);
}

/* Remove number input spinners */
.page-input::-webkit-outer-spin-button,
.page-input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
}
.page-input[type=number] {
    appearance: textfield;
}

.page-total {
    color: #9ca3af;
}

/* ── Accessibility ────────────────────────────────────────── */
.sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
}

/* ── Responsive ───────────────────────────────────────────── */
@media (max-width: 600px) {
    .viewer-top-bar {
        padding: 12px 16px;
    }
    
    .viewer-identity h2 {
        font-size: 0.95rem;
    }
    
    .viewer-subtitle {
        font-size: 0.7rem;
    }
    
    .magazine-controls {
        padding: 12px 16px;
        gap: 12px;
    }
    
    .control-btn {
        padding: 8px 12px;
        font-size: 12px;
    }
    
    .page-input {
        width: 40px;
    }
}
